# ─────────────────────────────────────────────────────────────────────────────
# Intégration LinkedIn — Member Data Portability API (3rd Party)
#
# Aucune de ces valeurs ne doit être commitée. En leur absence, l'application
# démarre en mode démonstration : mêmes routes, même normaliseur, même
# exécuteur, seule la source des données change.
# ─────────────────────────────────────────────────────────────────────────────

# Portail développeur LinkedIn → votre application → onglet « Auth »
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Doit correspondre EXACTEMENT à une URL de redirection déclarée dans l'onglet
# « Auth » de l'application LinkedIn. La comparaison est stricte : le protocole,
# le domaine, le port et le chemin doivent être identiques.
#   développement : http://localhost:3000/api/auth/linkedin/callback
#   production    : https://votre-domaine.fr/api/auth/linkedin/callback
LINKEDIN_REDIRECT_URI=

# `r_dma_portability_3rd_party` porte le profil, les postes, les formations,
# les compétences, les langues et les certifications.
# `openid profile email` est nécessaire pour la photo, absente du domaine
# PROFILE de l'API de portabilité.
LINKEDIN_SCOPES="openid profile email r_dma_portability_3rd_party"

# Secret de signature du paramètre `state` OAuth (anti-CSRF).
# Générer avec : openssl rand -base64 48
OAUTH_STATE_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Rendu PDF
# ─────────────────────────────────────────────────────────────────────────────

# Chemin d'un binaire Chromium. Sans lui, l'export PDF renvoie un 503 explicite
# et l'application propose l'impression navigateur en repli.
CHROMIUM_PATH=
